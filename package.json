{
  "name": "localreel-web",
  "private": true,
  "version": "0.5.8",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test src/app/match.test.ts src/data/cache.test.ts src/i18n/i18n.test.ts src/lib/feed.test.ts src/lib/format.test.ts src/lib/preview.test.ts src/lib/resume.test.ts src/lib/text.test.ts",
    "test:browser": "node scripts/browser-resume-mock.mjs",
    "test:watch": "node scripts/browser-resume-mock.mjs --watch",
    "test:admin": "node scripts/browser-admin-mock.mjs",
    "test:hls": "node scripts/browser-resume-mock.mjs --hls"
  },
  "dependencies": {
    "hls.js": "^1.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.3"
  }
}
